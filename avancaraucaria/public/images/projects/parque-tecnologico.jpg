<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#dcfce7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ccfbf1;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <g transform="translate(400,300)">
    <circle r="80" fill="#16a34a" opacity="0.1"/>
    <circle r="60" fill="#14b8a6" opacity="0.15"/>
    <circle r="40" fill="#22c55e" opacity="0.2"/>
    <text x="0" y="10" font-family="system-ui" font-size="24" font-weight="bold" fill="#166534" text-anchor="middle">Parque Tecnológico</text>
    <text x="0" y="40" font-family="system-ui" font-size="14" fill="#15803d" text-anchor="middle">Araucária</text>
  </g>
</svg>